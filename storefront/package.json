{
  "name": "remorseless-records-storefront",
  "version": "0.1.0",
  "private": true,
  "description": "Remorseless Records brutal maximalism storefront powered by Next.js 16 and Medusa",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=26.0.0 <27",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/verify-client-bundle-secrets.mjs",
    "start": "next start",
    "lint": "pnpm --dir .. exec biome check --error-on-warnings storefront/src",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "pnpm run test:coverage:baseline && pnpm run test:coverage:transactional",
    "test:coverage:baseline": "vitest run --coverage",
    "test:coverage:transactional": "vitest run --coverage --config=vitest.transactional.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:critical": "playwright test --config=playwright.critical.config.ts",
    "test:e2e:cross-browser": "playwright test --config=playwright.cross-browser.config.ts",
    "test:e2e:launch": "playwright test --config=playwright.launch.config.ts",
    "test:e2e:headed": "playwright test --headed",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "@medusajs/icons": "^2.18.0",
    "@medusajs/js-sdk": "^2.18.0",
    "@medusajs/types": "^2.18.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@splidejs/react-splide": "^0.7.12",
    "@splidejs/splide-extension-auto-scroll": "^0.5.3",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.0",
    "@tanstack/pacer": "^0.21.1",
    "@tanstack/query-persist-client-core": "^5.101.4",
    "@tanstack/query-sync-storage-persister": "^5.101.4",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.8",
    "@vercel/otel": "2.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "immer": "11.1.15",
    "lucide-react": "^1.27.0",
    "meilisearch": "^0.60.0",
    "motion": "^12.42.2",
    "next": "^16.2.12",
    "quicklink": "^3.0.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "redis": "6.1.0",
    "sanitize-html": "2.17.7",
    "server-only": "^0.0.1",
    "simple-icons": "^16.27.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tsconfig-paths": "^4.2.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "2.16.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.11.3",
    "dotenv": "^17.4.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
