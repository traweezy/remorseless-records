NODE_ENV=development
# REDIS_URL=redis://localhost:6379 # Optional - falls back to simulated redis
ADMIN_CORS=http://localhost:7000,http://localhost:7001,https://docs.medusajs.com
STORE_CORS=http://localhost:8000,https://docs.medusajs.com
AUTH_CORS=http://localhost:7000,http://localhost:7001,https://docs.medusajs.com
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa # Make sure this database exist - or change connection string to an online database

MEDUSA_ADMIN_EMAIL=admin@yourmail.com
MEDUSA_ADMIN_PASSWORD=supersecret

STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe test/live Payment Method Configuration ID (pmc_...). Keep this
# configuration limited to checkout methods exercised by the full test matrix.
STRIPE_PAYMENT_METHOD_CONFIGURATION=

# Shared server-only HMAC key used exclusively for the Storefront checkout
# recovery BFF. Set the same cryptographically random 32+ byte value on both
# Backend and Storefront; never expose it through a public environment prefix.
CHECKOUT_BFF_SECRET=

# Safety net for an official Stripe webhook or browser completion response that
# is delayed or lost. Disabled by default; it never creates/confirms payments.
CHECKOUT_RECONCILIATION_ENABLED=false
CHECKOUT_RECONCILIATION_MIN_AGE_SECONDS=120
CHECKOUT_RECONCILIATION_MAX_ATTEMPTS=50

# Cart data retention. The first job removes carts that never entered checkout.
# The second removes guest checkouts containing contact/address PII, but only
# after protecting order-linked and unresolved payment states.
ANONYMOUS_CART_RETENTION_ENABLED=false
ANONYMOUS_CART_RETENTION_DAYS=37
ANONYMOUS_CART_RETENTION_MAX_DELETIONS=1000
ABANDONED_CHECKOUT_RETENTION_ENABLED=false
ABANDONED_CHECKOUT_RETENTION_DAYS=37
ABANDONED_CHECKOUT_RETENTION_MAX_DELETIONS=250

TAX_RATE_LOOKUP_PROVIDER=taxrate_io
TAX_RATE_LOOKUP_API_KEY=
TAX_RATE_LOOKUP_MODE=zip
# Reviewed ZIP used only when an admin deliberately spends one TaxRate.io
# request to refresh the provider's returned monthly quota.
TAX_RATE_LOOKUP_MONITOR_POSTAL_CODE=
TAX_RATE_LOOKUP_CACHE_TTL_MS=300000

# Stripe Tax stays unavailable in Tax Control until the account settings,
# sandbox registration, Stripe key mode, and shipping code all pass readiness.
# General tangible-goods shipping is txcd_92010001; change it only after a
# reviewed classification decision.
STRIPE_TAX_SHIPPING_TAX_CODE=txcd_92010001
STRIPE_TAX_QUOTE_TTL_MS=1800000

SENDGRID_API_KEY=
SENDGRID_FROM=

# S3-compatible object storage. Required in production; local development
# falls back to disk only when all of these values are absent.
# MINIO_ENDPOINT=https://your-minio-endpoint
# MINIO_ACCESS_KEY=your-access-key
# MINIO_SECRET_KEY=your-secret-key
# MINIO_BUCKET=custom-bucket-name # Optional - defaults to 'medusa-media'
# MINIO_REGION=us-east-1
# MINIO_FILE_URL=https://your-public-minio-endpoint/medusa-media

# Meilisearch is required in production. Configure both values together.
# MEILISEARCH_HOST=your-meilisearch-host # e.g. http://localhost:7700
# MEILISEARCH_ADMIN_KEY=your-admin-key
