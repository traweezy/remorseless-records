{
  "name": "backend",
  "version": "0.0.2",
  "description": "A Prebaked Medusa 2.0 backend",
  "author": "Rasmus Puls",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "seed": "node ./scripts/run-medusa.js ./src/scripts/seed.ts",
    "start": "cd .medusa/server && node --require ./observability-register.cjs ./node_modules/@medusajs/cli/cli.js start --verbose",
    "dev": "medusa develop",
    "email:dev": "pnpm dlx react-email@6.6.5 dev --dir=./src/modules/email-notifications/templates --port=3002",
    "search:rebuild": "node ./scripts/run-search-prepare.js",
    "search:check": "node ./scripts/run-medusa.js ./src/scripts/check-meilisearch-sync.ts",
    "search:rollback": "node ./scripts/run-medusa.js ./src/scripts/rollback-meilisearch.ts",
    "search:sync-settings": "node ./scripts/run-medusa.js ./src/scripts/sync-meilisearch-settings.ts",
    "search:sync": "pnpm run search:rebuild",
    "search:prepare": "pnpm run search:rebuild",
    "storage:check": "node ./scripts/run-medusa.js ./src/scripts/check-object-storage.ts",
    "storage:verify-write": "node ./scripts/run-medusa.js ./src/scripts/verify-object-storage-provider.ts",
    "release:prepare": "node ./scripts/release-prepare.mjs",
    "discography:build": "node ./scripts/run-medusa.js ./src/scripts/build-discography-from-products.ts",
    "discography:normalize-formats": "node ./scripts/run-medusa.js ./src/scripts/normalize-discography-formats.ts",
    "media:big-cartel:migrate": "node ./scripts/run-medusa.js ./src/scripts/migrate-big-cartel-media.ts",
    "news:seed": "node ./scripts/run-medusa.js ./src/scripts/seed-news.ts",
    "catalog:shelves:seed": "node ./scripts/run-medusa.js ./src/scripts/seed-catalog-shelves.ts",
    "catalog:shelves:copy": "node ./scripts/run-medusa.js ./src/scripts/reconcile-homepage-shelf-copy.ts",
    "catalog:authoring:audit": "node ./scripts/run-medusa.js ./src/scripts/audit-catalog-authoring.ts",
    "catalog:authoring:view-check": "node ./scripts/run-medusa.js ./src/scripts/check-catalog-authoring-views.ts",
    "catalog:options:repair": "node ./scripts/run-medusa.js ./src/scripts/repair-duplicate-product-options.ts",
    "catalog:options:orphans:repair": "node ./scripts/run-medusa.js ./src/scripts/repair-orphan-product-options.ts",
    "shipping:update": "node ./scripts/run-medusa.js ./src/scripts/update-shipping-options.ts",
    "region:us-only": "node ./scripts/run-medusa.js ./src/scripts/enforce-us-region.ts",
    "money:audit": "ts-node --swc ./src/cli/audit-monetary-units.ts",
    "database:role:audit": "ts-node --swc ./src/cli/audit-database-role.ts",
    "money:migrate-major": "ts-node --swc ./src/cli/migrate-monetary-units.ts",
    "test": "jest --runInBand --passWithNoTests",
    "test:coverage": "jest --runInBand --passWithNoTests --coverage",
    "lint": "eslint --ext .ts,.tsx --max-warnings=0 src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@lexical/history": "0.49.0",
    "@lexical/html": "0.49.0",
    "@lexical/link": "0.49.0",
    "@lexical/list": "0.49.0",
    "@lexical/react": "0.49.0",
    "@lexical/rich-text": "0.49.0",
    "@lexical/selection": "0.49.0",
    "@lexical/utils": "0.49.0",
    "@medusajs/admin-sdk": "^2.18.0",
    "@medusajs/admin-shared": "^2.18.0",
    "@medusajs/cli": "^2.18.0",
    "@medusajs/core-flows": "^2.18.0",
    "@medusajs/dashboard": "^2.18.0",
    "@medusajs/draft-order": "^2.18.0",
    "@medusajs/event-bus-redis": "^2.18.0",
    "@medusajs/file": "^2.18.0",
    "@medusajs/file-local": "^2.18.0",
    "@medusajs/file-s3": "2.18.0",
    "@medusajs/framework": "^2.18.0",
    "@medusajs/fulfillment": "^2.18.0",
    "@medusajs/fulfillment-manual": "^2.18.0",
    "@medusajs/icons": "^2.18.0",
    "@medusajs/js-sdk": "2.18.0",
    "@medusajs/medusa": "^2.18.0",
    "@medusajs/notification": "^2.18.0",
    "@medusajs/notification-sendgrid": "^2.18.0",
    "@medusajs/payment": "^2.18.0",
    "@medusajs/payment-stripe": "^2.18.0",
    "@medusajs/tax": "^2.18.0",
    "@medusajs/ui": "^4.2.0",
    "@medusajs/utils": "^2.18.0",
    "@medusajs/workflow-engine-redis": "^2.18.0",
    "@mikro-orm/core": "6.6.14",
    "@mikro-orm/knex": "6.6.14",
    "@mikro-orm/migrations": "6.6.14",
    "@mikro-orm/postgresql": "6.6.14",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/instrumentation-ioredis": "0.65.0",
    "@opentelemetry/instrumentation-knex": "0.61.0",
    "@opentelemetry/instrumentation-pg": "0.69.0",
    "@opentelemetry/instrumentation-redis": "0.65.0",
    "@opentelemetry/instrumentation-runtime-node": "0.30.0",
    "@opentelemetry/sdk-node": "0.217.0",
    "@react-email/render": "2.1.0",
    "@rokmohar/medusa-plugin-meilisearch": "^1.4.3",
    "@tanstack/react-form": "1.33.2",
    "awilix": "^8.0.1",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "lexical": "0.49.0",
    "medusajs-launch-utils": "^0.0.19",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "posthog-node": "^5.46.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "6.30.4",
    "redis": "^6.1.0",
    "resend": "6.18.0",
    "sanitize-html": "2.17.5",
    "sharp": "0.35.4",
    "stripe": "^22.3.2",
    "ts-node": "^10.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@medusajs/test-utils": "^2.18.0",
    "@mikro-orm/cli": "6.6.14",
    "@swc/core": "^1.15.46",
    "@swc/jest": "^0.2.39",
    "@tanstack/react-query": "5.64.2",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/sanitize-html": "2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.5",
    "jest": "^30.4.2",
    "prop-types": "^15.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=26.0.0 <27",
    "pnpm": ">=11.0.0 <12"
  }
}
