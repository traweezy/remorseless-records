ARG NODE_IMAGE=node:26.5.0-bookworm-slim@sha256:2d49d876e96237d76de412761cf05dbfe5aee325cc4406a4d41d5824c5bb8beb

FROM ${NODE_IMAGE}

ARG REVISION
LABEL org.opencontainers.image.description="Remorseless Records Medusa backend"
LABEL org.opencontainers.image.revision="${REVISION}"
LABEL org.opencontainers.image.source="https://github.com/traweezy/remorseless-records"

ENV COMMIT_SHA="${REVISION}" \
    NODE_ENV=production

WORKDIR /app

RUN rm -rf /usr/local/lib/node_modules/npm \
    /usr/local/bin/npm \
    /usr/local/bin/npx

COPY --chown=node:node backend/.medusa/server/ ./
COPY --chown=node:node backend/scripts/runtime-release-prepare.mjs ./scripts/runtime-release-prepare.mjs
COPY --chown=node:node backend/scripts/lib/release-prepare.mjs ./scripts/lib/release-prepare.mjs

USER node

EXPOSE 9000

CMD ["node", "--require", "./observability-register.cjs", "./node_modules/@medusajs/cli/cli.js", "start", "--verbose"]
