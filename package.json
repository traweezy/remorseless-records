{
  "name": "remorseless-records",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=26.0.0 <27",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --error-on-warnings .",
    "qa:lint": "biome check --error-on-warnings . && pnpm run qa:release-policy && pnpm run qa:service-container-resolution && pnpm run qa:admin-browser-boundary && pnpm run qa:admin-accessibility-boundary && pnpm run qa:railway-iac && pnpm run qa:database-release-boundary && pnpm run qa:browser-toolchain-security && pnpm run qa:storefront-provider-fixture && pnpm run qa:medusa-build-toolchain && pnpm run qa:dashboard-product-import && pnpm run qa:dashboard-product-create && pnpm run qa:dashboard-product-deletion && pnpm run qa:secure-artifacts && pnpm run qa:api-contract && pnpm run qa:framework-response-headers && pnpm run qa:workflow-scheduler-timestamps && pnpm run qa:checkout-recovery && pnpm run qa:commerce-reliability && pnpm run qa:tax-golden-matrix && pnpm run qa:disposable-integration-boundary && pnpm run qa:scheduler-observation && pnpm run qa:operations-observation && pnpm run qa:observability-bootstrap && pnpm run qa:railway-runtime-logs && pnpm --filter remorseless-records-storefront run typecheck && pnpm --filter backend exec tsc --noEmit",
    "api:contract:generate": "node scripts/generate-api-contract.mjs --write",
    "qa:api-contract": "node --test scripts/generate-api-contract.test.mjs && node scripts/generate-api-contract.mjs --check",
    "qa:release-policy": "node scripts/verify-release-branch-policy.mjs",
    "qa:service-container-resolution": "node scripts/verify-service-container-resolution.mjs",
    "qa:admin-browser-boundary": "node scripts/verify-admin-browser-boundary.mjs",
    "qa:admin-accessibility-boundary": "node scripts/verify-admin-accessibility-boundary.mjs",
    "qa:railway-iac": "node --no-warnings scripts/verify-railway-iac.mjs",
    "qa:database-release-boundary": "node --test scripts/release-prepare.test.mjs scripts/postgres-logical-backup.test.mjs scripts/media-backup.test.mjs",
    "qa:secure-artifacts": "node --test scripts/export-category-map.test.mjs",
    "qa:browser-toolchain-security": "node scripts/verify-browser-toolchain-security.mjs",
    "qa:storefront-provider-fixture": "node --test storefront/scripts/ci-medusa-fixture.test.mjs",
    "qa:medusa-build-toolchain": "node scripts/verify-medusa-build-toolchain.mjs",
    "qa:dashboard-product-import": "node scripts/verify-dashboard-product-import-boundary.mjs",
    "qa:dashboard-product-create": "node scripts/verify-dashboard-product-create-boundary.mjs",
    "qa:dashboard-product-deletion": "node scripts/verify-dashboard-product-deletion-boundary.mjs",
    "qa:framework-response-headers": "node scripts/verify-framework-response-headers.mjs",
    "qa:workflow-scheduler-timestamps": "node scripts/verify-workflow-scheduler-timestamp.mjs",
    "qa:checkout-recovery": "node scripts/verify-checkout-recovery-boundary.mjs",
    "qa:commerce-reliability": "node scripts/verify-commerce-reliability-matrix.mjs",
    "qa:tax-golden-matrix": "node scripts/verify-tax-golden-matrix.mjs",
    "qa:disposable-integration": "node scripts/run-disposable-integration.mjs",
    "qa:disposable-integration:services": "pnpm --filter backend run test:integration && pnpm run qa:api-contract",
    "qa:disposable-integration-boundary": "node scripts/verify-disposable-integration-boundary.mjs",
    "qa:scheduler-observation": "node --test scripts/observe-scheduler-health.test.mjs",
    "qa:operations-observation": "node --test scripts/observe-operations-health.test.mjs",
    "qa:observability-bootstrap": "node scripts/verify-observability-bootstrap.mjs",
    "qa:railway-runtime-logs": "node --test scripts/verify-railway-runtime-log.test.mjs",
    "qa:react-router-security": "node scripts/verify-react-router-security.mjs",
    "railway:plan:staging": "node scripts/railway-config.mjs plan",
    "railway:apply:staging": "node scripts/railway-config.mjs apply",
    "qa:storefront:coverage": "pnpm --filter remorseless-records-storefront run test:coverage",
    "data:build-import": "go run ./scripts/generate_remorseless_import.go",
    "data:apply-import": "go run ./scripts/apply_remorseless_import.go",
    "data:postgres:backup": "node scripts/postgres-logical-backup.mjs",
    "data:postgres:restore-drill": "node scripts/postgres-restore-drill.mjs",
    "data:media:backup": "node scripts/media-backup.mjs",
    "qa:a11y": "node qa/run-pa11y.cjs",
    "qa:mobile": "node qa/run-mobile-audit.mjs",
    "qa:admin:accessibility": "node qa/run-admin-accessibility-matrix.mjs",
    "qa:storefront:launch": "pnpm --filter remorseless-records-storefront run test:e2e:launch",
    "qa:lighthouse": "lhci autorun --config=./lighthouse/lhci.config.js",
    "qa:ci": "pnpm run qa:lint && pnpm run qa:mobile && pnpm run qa:a11y && pnpm run qa:lighthouse",
    "prepare": "if [ \"$CI\" = \"true\" ] || [ \"$NODE_ENV\" = \"production\" ]; then exit 0; fi; lefthook install"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@axe-core/puppeteer": "4.12.1",
    "@biomejs/biome": "2.5.11",
    "@lhci/cli": "0.15.1",
    "@railway/cli": "5.45.0",
    "esbuild": "^0.28.1",
    "lefthook": "^2.1.10",
    "pa11y": "^9.1.1",
    "proxy-agent": "8.0.2",
    "puppeteer": "25.3.0",
    "railway": "3.11.0"
  }
}
