{
  "name": "remorseless-records",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=26.0.0 <27",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --error-on-warnings .",
    "qa:lint": "biome check --error-on-warnings . && pnpm run qa:ci-shared-contracts-boundary && pnpm run qa:ci-shared-contracts && pnpm run qa:toolchain-runtime && pnpm run qa:posthog-runtime && pnpm run qa:release-policy && pnpm run qa:dependency-supply-chain && pnpm run qa:ci-runtime-security && pnpm run qa:runtime-images && pnpm run qa:admin-accessibility-boundary && pnpm run qa:railway-iac && pnpm run qa:browser-toolchain-security && pnpm run qa:medusa-build-toolchain && pnpm run qa:dashboard-product-import && pnpm run qa:dashboard-product-deletion && pnpm run qa:secure-artifacts && pnpm run qa:api-contract && pnpm run qa:framework-response-headers && pnpm run qa:checkout-recovery && pnpm run qa:commerce-reliability && pnpm run qa:tax-golden-matrix && pnpm run qa:scheduler-observation && pnpm run qa:railway-runtime-logs && pnpm --filter remorseless-records-storefront run typecheck && pnpm --filter backend exec tsc --noEmit",
    "qa:toolchain-runtime": "node --test --test-isolation=process --test-timeout=60000 --experimental-test-coverage --test-coverage-include=scripts/install-git-hooks.mjs --test-coverage-include=scripts/run-git-hook.mjs --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 scripts/git-hooks.test.mjs scripts/tsx-runtime.test.mjs",
    "qa:posthog-runtime": "node --test --test-isolation=process --test-timeout=30000 scripts/posthog-runtime.test.mjs",
    "qa:ci-shared-contracts": "pnpm run qa:service-container-resolution && pnpm run qa:storefront-response-boundary && pnpm run qa:admin-browser-boundary && pnpm run qa:database-release-boundary && pnpm run qa:storefront-provider-fixture && pnpm run qa:dashboard-product-create && pnpm run qa:workflow-scheduler-timestamps && pnpm run qa:disposable-integration-boundary && pnpm run qa:operations-observation && pnpm run qa:observability-bootstrap",
    "qa:ci-shared-contracts-boundary": "node --test --experimental-test-coverage --test-coverage-include=scripts/verify-ci-shared-contracts.mjs --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 scripts/verify-ci-shared-contracts.test.mjs && node scripts/verify-ci-shared-contracts.mjs",
    "api:contract:generate": "node scripts/generate-api-contract.mjs --write",
    "qa:api-contract": "node --test scripts/generate-api-contract.test.mjs && node scripts/generate-api-contract.mjs --check",
    "qa:release-policy": "node scripts/verify-release-branch-policy.mjs",
    "qa:dependency-supply-chain": "node --test scripts/verify-dependency-supply-chain-policy.test.mjs && node scripts/verify-dependency-supply-chain-policy.mjs",
    "qa:ci-runtime-security": "node --test scripts/verify-ci-runtime-security-policy.test.mjs && node scripts/verify-ci-runtime-security-policy.mjs",
    "qa:runtime-images": "node --test scripts/verify-runtime-image-policy.test.mjs && node scripts/verify-runtime-image-policy.mjs",
    "qa:service-container-resolution": "node scripts/verify-service-container-resolution.mjs",
    "qa:storefront-response-boundary": "node scripts/verify-storefront-response-boundary.mjs",
    "qa:admin-browser-boundary": "node scripts/verify-admin-browser-boundary.mjs",
    "qa:admin-accessibility-boundary": "node --test qa/admin-static-server.test.mjs && node scripts/verify-admin-accessibility-boundary.mjs",
    "qa:railway-iac": "node --no-warnings scripts/verify-railway-iac.mjs",
    "qa:database-release-boundary": "node --test scripts/release-prepare.test.mjs scripts/postgres-logical-backup.test.mjs scripts/postgres-restore.test.mjs scripts/recovery-process.test.mjs scripts/postgres-recovery-cli.test.mjs scripts/media-backup.test.mjs scripts/media-object-checksum.test.mjs scripts/media-backup-cli.test.mjs && pnpm run qa:redis-capacity",
    "qa:redis-capacity": "node --test --experimental-test-coverage --test-coverage-include=scripts/lib/redis-capacity-audit.mjs --test-coverage-include=scripts/lib/redis-audit-client.mjs --test-coverage-include=scripts/lib/cli-arguments.mjs --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 scripts/cli-arguments.test.mjs scripts/redis-capacity-audit.test.mjs scripts/redis-audit-client.test.mjs scripts/redis-audit-cli.test.mjs",
    "qa:secure-artifacts": "node --test scripts/export-category-map.test.mjs",
    "qa:browser-toolchain-security": "node scripts/verify-browser-toolchain-security.mjs",
    "qa:storefront-provider-fixture": "node --test storefront/scripts/ci-medusa-fixture.test.mjs",
    "qa:medusa-build-toolchain": "node scripts/verify-medusa-build-toolchain.mjs",
    "qa:dashboard-product-import": "node scripts/verify-dashboard-product-import-boundary.mjs",
    "qa:dashboard-product-create": "node scripts/verify-dashboard-product-create-boundary.mjs",
    "qa:dashboard-product-deletion": "node scripts/verify-dashboard-product-deletion-boundary.mjs",
    "qa:framework-response-headers": "node scripts/verify-framework-response-headers.mjs",
    "qa:workflow-scheduler-timestamps": "node scripts/verify-workflow-scheduler-timestamp.mjs",
    "qa:checkout-recovery": "node scripts/verify-checkout-recovery-boundary.mjs",
    "qa:commerce-reliability": "node scripts/verify-commerce-reliability-matrix.mjs",
    "qa:tax-golden-matrix": "node scripts/verify-tax-golden-matrix.mjs",
    "qa:disposable-integration": "node scripts/run-disposable-integration.mjs",
    "qa:disposable-integration:services": "pnpm --filter backend run test:integration && pnpm run qa:postgres-recovery:integration && pnpm run qa:redis-capacity:integration && pnpm run qa:api-contract && node --test scripts/medusa-session-rotation.integration.test.mjs",
    "qa:postgres-recovery:integration": "node --test scripts/postgres-recovery.integration.test.mjs",
    "qa:redis-capacity:integration": "node --test scripts/redis-capacity-audit.integration.test.mjs",
    "qa:disposable-integration-boundary": "node --test --experimental-test-coverage --test-coverage-include=scripts/run-disposable-integration.mjs --test-coverage-include=scripts/scan-disposable-integration-images.mjs --test-coverage-include=scripts/verify-disposable-integration-boundary.mjs --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 scripts/run-disposable-integration.test.mjs scripts/scan-disposable-integration-images.test.mjs scripts/verify-disposable-integration-boundary.test.mjs && node scripts/verify-disposable-integration-boundary.mjs",
    "qa:scheduler-observation": "node --test scripts/observe-scheduler-health.test.mjs",
    "qa:operations-observation": "node --test scripts/observe-operations-health.test.mjs",
    "qa:observability-bootstrap": "node scripts/verify-observability-bootstrap.mjs",
    "qa:railway-runtime-logs": "node --test scripts/verify-railway-runtime-log.test.mjs",
    "qa:react-router-security": "node scripts/verify-react-router-security.mjs",
    "railway:plan:staging": "node scripts/railway-config.mjs plan",
    "railway:apply:staging": "node scripts/railway-config.mjs apply",
    "qa:storefront:coverage": "pnpm --filter remorseless-records-storefront run test:coverage",
    "data:build-import": "go run ./scripts/generate_remorseless_import.go",
    "data:apply-import": "go run ./scripts/apply_remorseless_import.go",
    "data:postgres:backup": "node scripts/postgres-logical-backup.mjs",
    "data:postgres:restore-drill": "node scripts/postgres-restore-drill.mjs",
    "data:redis:audit": "node scripts/redis-capacity-audit.mjs",
    "data:media:backup": "node scripts/media-backup.mjs",
    "qa:a11y": "node qa/run-pa11y.cjs",
    "qa:mobile": "node qa/run-mobile-audit.mjs",
    "qa:admin:accessibility": "node qa/run-admin-accessibility-matrix.mjs",
    "qa:storefront:launch": "pnpm --filter remorseless-records-storefront run test:e2e:launch",
    "qa:lighthouse": "lhci autorun --config=./lighthouse/lhci.config.js",
    "qa:ci": "pnpm run qa:lint && pnpm run qa:mobile && pnpm run qa:a11y && pnpm run qa:lighthouse",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@axe-core/puppeteer": "4.12.1",
    "@biomejs/biome": "2.5.11",
    "@lhci/cli": "0.15.1",
    "@railway/cli": "5.45.0",
    "esbuild": "^0.28.2",
    "pa11y": "^9.1.1",
    "proxy-agent": "8.0.2",
    "puppeteer": "25.3.0",
    "railway": "3.11.0"
  }
}
