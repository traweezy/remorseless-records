diff --git a/dist/app.css b/dist/app.css
index 914b674205accf11063d4145e7b21dd53c783ba4..4c7b4375508846613808fe784a822f6e92e55b23 100644
--- a/dist/app.css
+++ b/dist/app.css
@@ -5459,3 +5459,16 @@ video {
 .\[\&_tr\]\:hover\:bg-ui-bg-subtle:hover tr {
   background-color: var(--bg-subtle);
 }
+
+@media (min-width:640px){.sm\:grid-cols-2{grid-template-columns:repeat(2,minmax(0,1fr))}}
+
+.grid-cols-\[1fr_24px\]{grid-template-columns:1fr 24px}
+
+/* Keep native authentication links legible, targetable and focused. */
+.rr-native-auth-link { display: inline-flex; align-items: center; min-height: 24px; cursor: pointer; }
+.rr-native-auth-link:focus-visible { outline: 2px solid var(--border-interactive); outline-offset: 2px; border-radius: 2px; }
+
+.rr-native-auth input + div > button[type="button"] { min-width: 24px; min-height: 24px; }
+
+.rr-native-order-link { display: inline-flex; align-items: center; min-width: 24px; min-height: 24px; cursor: pointer; }
+.rr-native-order-link:focus-visible { outline: 2px solid var(--border-interactive); outline-offset: -2px; border-radius: 2px; }
