diff --git a/src/routes/orders/common/return-inventory-guidance.ts b/src/routes/orders/common/return-inventory-guidance.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2c6adb43c812586e0e43ae811ef8e426a7d8a08d
--- /dev/null
+++ b/src/routes/orders/common/return-inventory-guidance.ts
@@ -0,0 +1,69 @@
+export type ClaimInventoryLocationMap = Record<string, string[] | null>
+export type ClaimInventoryContext = {
+  key: string
+  status: "loading" | "ready" | "unavailable"
+  locations: ClaimInventoryLocationMap
+}
+
+export function getClaimInventoryVariantIds(orderItems: unknown, inboundItems: unknown): string[] {
+  if (!Array.isArray(orderItems) || !Array.isArray(inboundItems)) throw new Error("Inventory guidance unavailable")
+  const items = new Map(orderItems.map(item => [item.id, item]))
+  if (items.size !== orderItems.length) throw new Error("Inventory guidance unavailable")
+  const ids = new Set<string>()
+  for (const field of inboundItems) {
+    const item = items.get(field.item_id)
+    if (!item) throw new Error("Inventory guidance unavailable")
+    if (item.variant_id == null) continue
+    if (!item.variant || typeof item.variant.manage_inventory !== "boolean") throw new Error("Inventory guidance unavailable")
+    if (!item.variant.manage_inventory) continue
+    if (typeof item.variant_id !== "string" || !/^variant_[A-Za-z0-9_-]+$/.test(item.variant_id)) throw new Error("Inventory guidance unavailable")
+    ids.add(item.variant_id)
+  }
+  return [...ids].sort()
+}
+
+export async function readClaimInventoryLocationMap(
+  variantIds: string[],
+  list: (query: { id: string[]; fields: string; limit: number; offset: number }) => Promise<unknown>
+): Promise<ClaimInventoryLocationMap> {
+  if (variantIds.length > 250 || new Set(variantIds).size !== variantIds.length) throw new Error("Inventory guidance unavailable")
+  const result: ClaimInventoryLocationMap = {}
+  const seen = new Set<string>()
+  const expected = new Set(variantIds)
+  let offset = 0
+  while (offset < variantIds.length) {
+    const value = await list({
+      id: variantIds, limit: 100, offset,
+      fields: "id,manage_inventory,inventory_items.inventory_item_id,inventory_items.required_quantity,inventory_items.inventory.id,*inventory_items.inventory.location_levels",
+    })
+    if (!value || typeof value !== "object") throw new Error("Inventory guidance unavailable")
+    const page = value as { variants?: unknown; count?: unknown; offset?: unknown; limit?: unknown }
+    if (!Array.isArray(page.variants) || page.count !== variantIds.length || page.offset !== offset || page.limit !== 100 || page.variants.length === 0 || page.variants.length > 100) throw new Error("Inventory guidance unavailable")
+    for (const variant of page.variants) {
+      if (!variant || !expected.has(variant.id) || seen.has(variant.id)) throw new Error("Inventory guidance unavailable")
+      seen.add(variant.id)
+      if (variant.manage_inventory === false) { result[variant.id] = null; continue }
+      if (variant.manage_inventory !== true || !Array.isArray(variant.inventory_items)) throw new Error("Inventory guidance unavailable")
+      let common: string[] | undefined
+      const components = new Set<string>()
+      for (const link of variant.inventory_items) {
+        if (!link || typeof link.inventory_item_id !== "string" || components.has(link.inventory_item_id) || !Number.isFinite(link.required_quantity) || link.required_quantity <= 0 || !link.inventory || link.inventory.id !== link.inventory_item_id || !Array.isArray(link.inventory.location_levels)) throw new Error("Inventory guidance unavailable")
+        components.add(link.inventory_item_id)
+        const locations: string[] = []
+        for (const level of link.inventory.location_levels) {
+          if (!level || typeof level.location_id !== "string" || !/^sloc_[A-Za-z0-9_-]+$/.test(level.location_id) || locations.includes(level.location_id)) throw new Error("Inventory guidance unavailable")
+          locations.push(level.location_id)
+        }
+        common = common === undefined ? locations : common.filter(location => locations.includes(location))
+      }
+      result[variant.id] = common ?? []
+    }
+    offset += page.variants.length
+  }
+  if (seen.size !== variantIds.length) throw new Error("Inventory guidance unavailable")
+  return result
+}
+
+export function claimInventoryLocationWarning(context: ClaimInventoryContext, key: string, ids: string[], locationId: string | undefined): boolean {
+  return !!locationId && context.key === key && context.status === "ready" && ids.some(id => context.locations[id] !== null && !context.locations[id]?.includes(locationId))
+}
